# Sao chép tệp này thành ".env" nếu công cụ triển khai của bạn đọc .env
# (ứng dụng cũng chạy tốt chỉ với biến môi trường hệ thống, không bắt buộc có .env)

# Cổng máy chủ HTTP
PORT=3000

# Chuỗi kết nối Postgres (Neon, Supabase, hoặc bất kỳ Postgres nào).
# Để trống = dùng file data/db.json cục bộ (mất dữ liệu nếu hosting không có
# ổ đĩa bền vững, ví dụ Render gói free). Đặt biến này khi triển khai thật.
# Dạng: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Khóa bí mật để ký token phiên đăng nhập (HMAC).
# Bắt buộc đặt một chuỗi ngẫu nhiên dài khi triển khai thật — nếu bỏ trống,
# máy chủ tự sinh khóa mới mỗi lần khởi động và mọi phiên đăng nhập cũ sẽ mất hiệu lực.
SOS_SECRET=

# 1 = bật chế độ demo (hiện mã OTP trên màn hình, hiện sẵn danh sách tài khoản mẫu).
# Đặt 0 khi triển khai thật cho người dùng thật.
SOS_DEMO=1

# Số giây trước khi một cảnh báo SOS chưa được xác nhận tự động leo thang lên Ban giám hiệu.
SOS_ESCALATE_SEC=60
